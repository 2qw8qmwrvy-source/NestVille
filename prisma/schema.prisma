// Prisma schema for NestVille
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  passwordHash    String
  role            String         @default("student")
  createdAt       DateTime       @default(now())
  listings        Listing[]
  roommatePosts   RoommatePost[]
  favorites       Favorite[]
  ratingsGiven    Rating[]       @relation("RatingsGiven")
  ratingsReceived Rating[]       @relation("RatingsReceived")
}

model Listing {
  id                    String         @id @default(cuid())
  title                 String
  description           String
  address               String
  neighborhood          String?
  price                 Int
  bedrooms              Int
  bathrooms             Float
  propertyType          String
  availableFrom         DateTime
  leaseLength           String?
  furnished             Boolean        @default(false)
  petsAllowed           Boolean        @default(false)
  utilitiesIncluded     Boolean        @default(false)
  parking               Boolean        @default(false)
  laundry               Boolean        @default(false)
  status                String         @default("active")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  authorId              String
  author                User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images                ListingImage[]
  favorites             Favorite[]

  @@index([authorId])
  @@index([status])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model RoommatePost {
  id          String    @id @default(cuid())
  type        String
  title       String
  description String
  price       Int?
  location    String?
  moveInDate  DateTime?
  moveOutDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([type])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model Rating {
  id          String   @id @default(cuid())
  score       Int
  comment     String?
  createdAt   DateTime @default(now())
  raterId     String
  ratedUserId String
  rater       User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser   User     @relation("RatingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([raterId, ratedUserId])
  @@index([ratedUserId])
}
